# ==========================================
# Evently Backend Environment Configuration
# ==========================================

# Secret Key: Generate a random 50-character string for production.
# Example: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key-in-production

# Debug Mode: Set to False in production.
DEBUG=True

# Allowed Hosts: Comma-separated list of hostnames/domains.
# In production, include your backend domain, e.g., evently-api.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,evently-backend.onrender.com

# Database URL:
# For local development with SQLite, leave empty.
# For production PostgreSQL, provide the connection string:
# DATABASE_URL=postgresql://user:password@host:port/dbname
# DATABASE_URL=

# CORS Allowed Origins: Comma-separated list of exact frontend origins (NO trailing slashes or paths).
# Include local dev servers and production Vercel domain.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8443,https://evently-calendar.vercel.app

# CSRF Trusted Origins: Comma-separated list of origins trusted for CSRF protection.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8443,https://evently-calendar.vercel.app

# Timezone (e.g. UTC, Asia/Kolkata, America/New_York)
TIME_ZONE=UTC

# Token Expiration (seconds)
# ACCESS_TOKEN_LIFETIME=3600    # 1 hour
# REFRESH_TOKEN_LIFETIME=604800 # 7 days

# Google OAuth 2.0 Client ID (Optional)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Production Security Flags (Default: True when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
