# ==========================================
# Evently Frontend Environment Configuration
# ==========================================

# Base URL of the Django REST API (must end with /api without trailing slash)
# Local development:
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Production example (Render / Railway backend):
# VITE_API_BASE_URL=https://evently-api.onrender.com/api

# Google OAuth 2.0 Web Client ID (Optional)
# If provided, enables Google Sign-In button on the login screen.
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
